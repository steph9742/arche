#!/usr/bin/env python3
"""Helper de DÉMONSTRATION — données fictives, pour prévisualiser l'interface.

Ne jamais installer en production : le vrai helper est helper/arche-helper.
"""
import json, sys, pathlib, os

MEM = pathlib.Path(os.environ.get("DEV_MEM", "/tmp/arche-dev-conf.json"))
cmd = sys.argv[1] if len(sys.argv) > 1 else ""

if cmd == "etat":
    print(json.dumps({
        "yunohost": {"verdict": "succès", "horodatage": "2026-07-27T02:21:14",
                     "applications": {"nextcloud": "restaurée", "vaultwarden": "restaurée",
                              "dex": "restaurée", "wiki": "restaurée"}},
        "docker": {"verdict": "partiel", "horodatage": "2026-07-27T03:04:52",
                   "piles": {"notes": "démarrée", "tableau": "démarrée",
                             "wiki": "ÉCHEC de construction",
                             "wiki-db": "restaurée (27 tables)"}},
        "archives": [{"nom": "20260727-000001.tar", "taille": 12884901888, "date": "2026-07-27 02:10"},
                     {"nom": "20260726-000001.tar", "taille": 12781748224, "date": "2026-07-26 02:09"},
                     {"nom": "20260724-000001.tar", "taille": 12669943808, "date": "2026-07-24 02:11"}],
        "services_morts": [], "restauration_en_cours": False,
        "canaris_configures": False, "timer": "active",
        "prochain_reveil": "2026-07-28 02:00"}))
elif cmd == "conf-lire":
    print(json.dumps({"valeurs": json.loads(MEM.read_text()) if MEM.exists() else {},
                      "secrets_definis": []}))
elif cmd == "conf-ecrire":
    sys.path.insert(0, os.environ.get("DEV_RACINE", "."))
    from app.praconf import valider, ValeurInvalide
    try:
        propre = valider(json.load(sys.stdin)["valeurs"])
    except ValeurInvalide as e:
        print(json.dumps({"erreur": str(e)})); sys.exit(1)
    MEM.write_text(json.dumps(propre))
    print(json.dumps({"ok": True, "reglages": len(propre)}))
elif cmd == "apps":
    # Le helper de démo doit couvrir TOUTES les commandes du vrai, sinon
    # l'interface affiche « commande inconnue » là où l'exploitant verra des
    # cases à cocher — la prévisualisation ne montre alors pas ce qu'il aura.
    print(json.dumps({"apps": [
        {"id": n, "nom": n.capitalize()} for n in
        ("bookstack", "cyberchef", "dex", "diagramsnet", "freshrss", "moodle",
         "n8n", "nextcloud", "vaultwarden")]}))
elif cmd == "tracer":
    print(json.dumps({"ok": True}))
elif cmd == "sauvegarder":
    print(json.dumps({"ok": True, "pid": 4242}))
elif cmd == "cibles":
    print(json.dumps({
        "applications": [{"id": n, "vue_hier": True} for n in
                         ("dex","nextcloud","bookstack","vaultwarden","n8n","moodle",
                          "freshrss","redirect","redirect__2","redirect__3",
                          "reverseproxy","reverseproxy__2","reverseproxy__3",
                          "reverseproxy__4","reverseproxy__5","reverseproxy__6")],
        "piles": [{"id": n} for n in ("notes","wiki","tableau",
                                      "recherche","uptime-kuma")],
        "horodatage_yunohost": "2026-07-28T02:21:14",
        "horodatage_docker": "2026-07-28T03:04:52"}))
elif cmd == "journal":
    # Le vrai helper sert un fichier DIFFÉRENT selon le journal demandé. Renvoyer
    # partout les mêmes lignes donnait une prévisualisation trompeuse : l'onglet
    # « Qui a fait quoi » affichait la réplication nocturne.
    quel = sys.argv[2] if len(sys.argv) > 2 else "nightly"
    ECHANTILLONS = {
        "nightly": ("/var/log/pra_nightly.log", [
            "[2026-07-27 02:10:02] ===== PRA NIGHTLY START =====",
            "[2026-07-27 02:10:04] Vérification de la connectivité",
            "[2026-07-27 02:10:06]   203.0.113.10 joignable",
            "[2026-07-27 02:10:08]   203.0.113.20 joignable",
            "[2026-07-27 02:10:08] Vérification des canaris sur la production",
            "[2026-07-27 02:10:11]   4 canari(s) intact(s), 0 en défaut",
            "[2026-07-27 02:10:11] Récupération de l'instantané Docker du jour",
            "[2026-07-27 02:21:14] Contrôles anti-rançongiciel",
            "[2026-07-27 02:21:17]   aucune anomalie",
            "[2026-07-27 02:21:18] ATTENTION  uptime-kuma en réseau host",
            "[2026-07-27 03:04:52] ==== FIN — succès ====",
        ]),
        "restauration": ("/var/log/pra_restore.log", [
            "[2026-07-27 02:12:40] Archive préparée : 20260727-000001.tar",
            "[2026-07-27 02:13:02] Empreinte conforme, domaines d'origine présents",
            "[2026-07-27 02:13:05]   taille 11 849 Mo, écart à la médiane : 0 %",
            "[2026-07-27 02:19:31] URL de n8n → arche.exemple.test/n8n",
            "[2026-07-27 02:20:44] ATTENTION  binaire compilé pour x86 : dex",
            "[2026-07-27 02:21:02]   dex réparé et actif",
            "[2026-07-27 02:21:10] ==== FIN — verdict : succès ====",
        ]),
        "docker": ("/var/log/pra_docker_restore.log", [
            "[2026-07-27 02:22:03] Pile notes : volumes restaurés",
            "[2026-07-27 02:25:41] Pile wiki : ÉCHEC de construction",
            "[2026-07-27 03:04:52] ==== FIN — verdict : partiel ====",
        ]),
        "alertes": ("/var/log/pra_notify.log", [
            "[2026-07-27 03:04:53] [echec] Volet Docker partiel : wiki",
            "[2026-07-27 03:04:53] destination épinglée : nuage.exemple.test -> 203.0.113.10",
            "[2026-07-27 03:04:54] notification transmise (HTTP 201)",
        ]),
        "audit": ("/var/log/arche-audit.log", [
            "2026-07-27 09:14:02\tmartin@exemple.test\tréglages enregistrés — "
            "PRA_GFS_JOURS : « 4 » → « 6 »",
            "2026-07-27 09:15:41\tmartin@exemple.test\tcanaris:verifier",
            "2026-07-27 10:02:18\tcamille@exemple.test\tréglages enregistrés — "
            "NC_TALK_SECRET : nouvelle valeur (secret non journalisé)",
            "2026-07-27 10:03:00\tcamille@exemple.test\talerte d'essai",
            "2026-07-27 14:40:55\tmartin@exemple.test\trestauration lancée (mode=validation)",
        ]),
    }
    fichier, lignes = ECHANTILLONS.get(quel, ECHANTILLONS["nightly"])
    print(json.dumps({"fichier": fichier, "absent": False, "lignes": lignes}))
elif cmd == "canaris":
    print(json.dumps({"ok": True, "sortie": "4 canari(s) intact(s), 0 en défaut"}))
elif cmd == "tester-alerte":
    print(json.dumps({"ok": True, "detail": "notification transmise (HTTP 201)"}))
elif cmd == "restaurer":
    print(json.dumps({"ok": True, "pid": 12345, "mode": "validation"}))
else:
    print(json.dumps({"erreur": f"commande inconnue : {cmd}"})); sys.exit(1)
