# Sauvegarde quotidienne YunoHost de la PRODUCTION, source du PRA.
#
# Cette planification ne doit pas vivre dans la crontab de root, hors de tout
# suivi en versions : install.sh la dépose ici et AVERTIT si un
# doublon subsiste dans la crontab de root : deux sauvegardes simultanées se
# marcheraient dessus.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 0 * * * root /usr/local/sbin/yunohost_backup_daily.sh >> /var/log/yunohost_backup.log 2>&1
