def _taille(chemin: Path, sauf: tuple[Path, ...] = ()) -> int:
    """Octets occupés, sans lever si le répertoire disparaît en cours de route.

    « sauf » écarte des sous-arbres : iso/kiwix vit DANS iso/, et sans cette
    exclusion les archives seraient comptées deux fois — le total afficherait
    plus que ce que le disque contient, ce qui décrédibilise tout le tableau.
    """
    total = 0
    try:
        for f in chemin.rglob("*"):
            try:
                if not f.is_file() or f.is_symlink():
                    continue
                if any(x in f.parents for x in sauf):
                    continue
                total += f.stat().st_size
            except OSError:
                continue
    except OSError:
        pass
    return total


DEPOT_VERROU = Path("/run/arche-depot.lock")


def _depot_tourne() -> bool:
    """Un téléchargement est-il en cours ? On regarde les PROCESSUS, pas un
    fichier : un verrou oublié après un arrêt brutal mentirait indéfiniment."""
    try:
        r = subprocess.run(["pgrep", "-f", "sbin/pra_depot_isos"],
                           capture_output=True, timeout=10)
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def _depot_prendre_verrou(quoi: str):
    """Interdit deux opérations simultanées sur le dépôt.

    Le contrôle par « pgrep » ne suffit pas : entre le moment où on regarde et
    celui où on lance, deux requêtes peuvent passer toutes les deux — deux
    téléchargements écrivant le même fichier, ce qui corrompt l'image sans que
    rien ne le signale. La création du verrou est donc ATOMIQUE
    (O_EXCL) : le second à essayer échoue, quelle que soit la vitesse.

    Un verrou dont le processus est mort est retiré : sans cela, un arrêt brutal
    bloquerait le dépôt jusqu'à une intervention manuelle.
    """
    try:
        contenu = DEPOT_VERROU.read_text(encoding="utf-8").split(None, 1)
        pid = int(contenu[0])
        os.kill(pid, 0)                      # le processus vit-il encore ?
        detenteur = contenu[1].strip() if len(contenu) > 1 else "une opération"
        echouer(f"{detenteur} est déjà en cours sur le dépôt — attendez qu'elle "
                "se termine")
    except (OSError, ValueError, IndexError):
        # Absent, illisible, ou processus mort : le verrou ne vaut rien.
        try:
            DEPOT_VERROU.unlink()
        except OSError:
            pass

    try:
        fd = os.open(str(DEPOT_VERROU), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
    except FileExistsError:
        echouer("une opération vient d'être lancée sur le dépôt")
    with os.fdopen(fd, "w") as f:
        f.write(f"{os.getpid()} {quoi}")
    return DEPOT_VERROU


def _depot_rendre_verrou() -> None:
    try:
        DEPOT_VERROU.unlink()
    except OSError:
        pass


def cmd_depot_etat(_args) -> None:
    kiwix = DEPOT / "iso" / "kiwix"
    parties = []
    for libelle, rel, motifs in DEPOT_PARTIES:
        # « @manuels » désigne le répertoire servi par nginx, hors du dépôt.
        d = MANUELS if rel == "@manuels" else DEPOT / rel
        n = 0
        try:
            for m in motifs:
                n += sum(1 for f in d.rglob(m)
                         if f.is_file() and kiwix not in f.parents)
        except OSError:
            pass
        # Seule la ligne « images » exclut Kiwix : la ligne Kiwix, elle, doit
        # bien compter son propre contenu.
        sauf = (kiwix,) if rel == "iso" else ()
        if rel == "iso/kiwix":
            n = sum(1 for m in motifs for f in d.rglob(m) if f.is_file()) \
                if d.exists() else 0
        parties.append({"libelle": libelle,
                        "chemin": str(MANUELS) if rel == "@manuels" else rel,
                        "octets": _taille(d, sauf), "fichiers": n})

    libre = None
    try:
        st = os.statvfs(DEPOT)
        libre = st.f_bavail * st.f_frsize
    except OSError:
        pass

    manifeste = DEPOT / "MANIFESTE-DEPOT.txt"
    quand = None
    try:
        quand = datetime.fromtimestamp(manifeste.stat().st_mtime).isoformat(
            timespec="seconds")
    except OSError:
        pass

    # Les dernières lignes utiles du journal : la barre de progression de curl
    # est écartée, sinon on rendrait des milliers de caractères illisibles.
    lignes = []
    try:
        brut = DEPOT_JOURNAL.read_text(encoding="utf-8", errors="replace")
        for ligne in brut.replace("\r", "\n").splitlines():
            l = ligne.strip()
            if l and "%" not in l and "#" not in l:
                lignes.append(l)
    except OSError:
        pass

    # L'adresse à laquelle les manuels sont réellement servis. Sans elle,
    # l'interface ne pourrait donner qu'un chemin de fichier, inutilisable dans
    # un navigateur — et personne ne devinerait le port.
    manuels_url = None
    try:
        if any(MANUELS.rglob("*.html")):
            r = subprocess.run(["ip", "-4", "-br", "addr"],
                               capture_output=True, text=True, timeout=10).stdout
            for ligne in r.splitlines():
                ch = ligne.split()
                if len(ch) >= 3 and ch[1] == "UP" and not re.match(
                        r"^(lo|docker|br-|veth|virbr)", ch[0]):
                    manuels_url = "http://%s:8080/manuels/" % ch[2].split("/")[0]
                    break
    except (OSError, subprocess.SubprocessError):
        pass

    sortir({
        "parties": parties,
        "manuels_url": manuels_url,
        "total_octets": sum(p["octets"] for p in parties),
        "libre_octets": libre,
        "manifeste": quand,
        "en_cours": _depot_tourne(),
        "journal": lignes[-12:],
    })


def cmd_depot_verifier(_args) -> None:
    """Compare au publié sans rien télécharger. Quelques dizaines de secondes :
    on reste synchrone, l'utilisateur attend le résultat."""
    if not DEPOT_SCRIPT.exists():
        echouer(f"{DEPOT_SCRIPT} absent")
    if _depot_tourne():
        echouer("une mise à jour est en cours : la vérification rendrait un état "
                "incohérent, attendez qu'elle se termine")
    _depot_prendre_verrou("une vérification")
    try:
        r = subprocess.run([str(DEPOT_SCRIPT), "--verifier"],
                           capture_output=True, timeout=600)
    except subprocess.TimeoutExpired:
        _depot_rendre_verrou()
        echouer("la vérification a dépassé dix minutes")
    finally:
        _depot_rendre_verrou()
    texte = r.stdout.decode("utf-8", "replace")
    a_jour, renouveler, absents = [], [], []
    for ligne in texte.splitlines():
        l = ligne.strip()
        if not l:
            continue
        if " à jour (" in l:
            a_jour.append(l.split(" à jour (")[0].strip())
