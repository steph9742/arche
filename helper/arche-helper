            renouveler.append(l.split("NOUVELLE VERSION")[0].strip())
        elif " absent : " in l:
            absents.append(l.split(" absent : ")[0].strip())
    sortir({"ok": True, "a_jour": a_jour, "a_renouveler": renouveler,
            "absents": absents})


def _lancer_hors_cgroup(nom: str, commande: list[str], journal: Path,
                        env: dict | None = None, ajouter: bool = False) -> int:
    """Lancer un travail long DANS SON PROPRE CGROUP, hors de celui de la webapp.

    « start_new_session=True » ne suffit pas : setsid change de SESSION, pas de
    CGROUP. Or arche.service a « KillMode=control-group » — un
    « systemctl restart arche » envoie donc SIGTERM à tout le cgroup, y compris
    aux travaux détachés.

    Un déploiement tue alors une mise à jour du dépôt en cours, qui venait de
    retélécharger plusieurs gigaoctets : le journal s'arrête net à l'heure du
    « restart ». Rien ne le signale — ni le journal, ni
    l'interface : le travail avait simplement disparu.

    C'est inacceptable pour ce dispositif : les opérations qui comptent ici durent
    des heures, et déployer un correctif est un geste anodin qu'on fait sans
    penser à ce qui tourne. On passe donc par une unité transitoire — systemd la
    place dans son propre cgroup, et elle survit à tout redémarrage de la webapp.

    Repli sur l'ancien comportement si systemd-run est absent : mieux vaut un
    travail fragile qu'un travail impossible, mais on le journalise.
    """
    journal.parent.mkdir(parents=True, exist_ok=True)
    # LE JOURNAL EST VIDÉ ICI, PAS PAR SYSTEMD.
    #
    # Poser « StandardOutput=truncate: » et « StandardError=append: » sur le MÊME
    # fichier fait perdre les messages d'erreur : systemd ouvre les deux flux
    # séparément et la troncature du premier efface ce que le second vient
    # d'écrire. Résultat : un bilan « 64 réussis, 14 en échec » sans une seule
    # ligne disant lesquels — un compte rendu inexploitable, c'est-à-dire
    # exactement le défaut que ce dispositif cherche à éviter.
    #
    # On vide donc soi-même avant de lancer, et les deux flux se contentent
    # d'ajouter. L'ordre des lignes est alors celui de l'écriture.
    if not ajouter:
        journal.write_bytes(b"")
    if shutil.which("systemd-run"):
        cmd = [
            "systemd-run", "--quiet", "--collect",
            f"--unit=arche-{nom}",
            "--property=Type=simple",
            f"--property=StandardOutput=append:{journal}",
            f"--property=StandardError=append:{journal}",
            "--property=StandardInput=null",
        ]
        for cle, val in (env or {}).items():
            cmd.append(f"--setenv={cle}={val}")
        cmd.append("--")
        cmd += commande
        r = subprocess.run(cmd, capture_output=True, timeout=30)
        if r.returncode == 0:
            return 0                     # l'unité vit sa vie, pas de PID à rendre
        # systemd a refusé : on le dit dans le journal du travail lui-même, sinon
        # l'utilisateur voit une opération qui n'a jamais commencé sans raison.
        with open(journal, "ab") as f:
            f.write(b"systemd-run a refuse de lancer l'unite, repli sur un "
                    b"processus detache (fragile : un redemarrage de la webapp "
                    b"l'interrompra)\n")
            f.write(r.stderr[:500])
            f.write(b"\n")
    with open(journal, "ab" if ajouter else "wb") as sortie:
        proc = subprocess.Popen(
            commande, stdout=sortie, stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL, start_new_session=True,
            env={**os.environ, **(env or {})},
        )
    return proc.pid


def cmd_depot_majour(_args) -> None:
