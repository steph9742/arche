def sortir(charge: dict, code: int = 0) -> None:
    json.dump(charge, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    sys.exit(code)


def echouer(message: str) -> None:
    """Sort en erreur avec un message JSON exploitable par la webapp."""
    sortir({"erreur": message}, 1)


