# ── santé réelle ────────────────────────────────────────────────────────────


def _sonder(url: str, hote: str | None = None, delai: int = 6) -> str:
    """Le code HTTP réel, ou « 000 » si rien ne répond.

    On passe par curl et non par urllib : il faut résoudre le nom vers 127.0.0.1
    tout en conservant le bon en-tête Host et la bonne SNI — sinon on teste le
    DNS et le réseau au lieu de tester le service.
    """
    cmd = ["curl", "-sk", "-o", "/dev/null", "-w", "%{http_code}",
           "--max-time", str(delai)]
    if hote:
        cmd += ["--resolve", f"{hote}:443:127.0.0.1"]
    cmd.append(url)
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=delai + 4)
        return r.stdout.decode().strip() or "000"
    except Exception:
        return "000"


def _verdict_http(code: str, racine_nue: bool = False) -> str:
    """Traduire un code en jugement — c'est là que se joue l'utilité de la page.

    Un 401 ou un 403 signifie « le service répond et demande à s'authentifier » :
    c'est un SUCCÈS, pas une panne. Et 502/503/504 désignent un mandataire qui
    n'atteint pas son amont, la panne la plus fréquente ici.

    « racine_nue » distingue les deux sondes, et c'est essentiel :

      - Pour une APPLICATION, on interroge le chemin qu'elle déclare. Un 404 y est
        une anomalie : l'application dit servir là et ne sert rien.
      - Pour une PILE Docker, on interroge la racine du port publié. Or une
        application servie sous un sous-chemin rend 404 à sa racine, et c'est la
        PREUVE que son mandataire fonctionne. La classer en anomalie ferait
        exactement ce qu'on cherche à éviter : inquiéter à tort, sur un service
        auquel l'exploitant accède parfaitement.
    """
    if code == "000":
        return "injoignable"
    if code in ("502", "503", "504"):
        return "passerelle"
    if code.startswith(("2", "3")) or code in ("401", "403"):
        return "ok"
    if racine_nue and code == "404":
        return "ok"          # le mandataire répond ; la pile vit sous un sous-chemin
    return "anomalie"


def cmd_sante_lire(_args) -> None:
    """La DERNIÈRE mesure, telle qu'elle a été écrite — sans resonder.

    La webapp l'appelle à chaque affichage de la page : c'est instantané, et
    l'horodatage du fichier dit de quand date la mesure. Séparer la lecture du
    sondage évite qu'une page consultée par curiosité déclenche trente requêtes.
    """
    sortir(_json_si_possible(ETAT_DIR / "sante.json") or {})


# SONDER LE POINT D'ENTRÉE QUI PROUVE QUELQUE CHOSE.
#
# La racine d'une application ne dit pas toujours si elle vit : nginx sert
# souvent des fichiers statiques devant elle. Fournisseur d'identité arrêté :
#     /dex/                                 -> 200   (fichiers servis par nginx)
#     /dex/.well-known/openid-configuration -> 502   (le vrai point d'entrée)
# La page Santé déclarerait donc « ok » un fournisseur d'identité mort —
# c'est-à-dire exactement la panne de la nuit précédente, celle qu'elle existe
# pour attraper.
#
# On ne peut pas deviner le bon chemin pour chaque application : on le nomme là
# où l'on sait que la racine ment. Ailleurs, la racine reste le meilleur choix.
CHEMINS_SONDE = {
    # dex ne répond vraiment que sur sa découverte OIDC.
    "dex": ".well-known/openid-configuration",
}


def _seconde_chance(applications, piles, par_id,
                    budget=None, pas=None, sonder=None, dormir=None):
    """Redemander à ce qui ne répond pas encore. Rend le temps total attendu.

    LA SONDE MESURAIT LE TEMPS DE DÉMARRAGE, PAS LA SANTÉ.

    Elle tourne juste après la restauration des piles. Or certaines
    applications mettent plusieurs dizaines de secondes à servir, et leur
    mandataire rend 502 tant qu'il n'a pas d'amont : presque chaque nuit
    annonce donc « ne répond plus » pour un couple debout deux minutes plus
    tard. Une alerte qui se trompe régulièrement cesse d'être lue — et le jour
    où elle aura raison, personne ne la croira.

    On ne redemande QU'À CE QUI A ÉCHOUÉ : le coût n'est payé que dans le cas
    anormal. Et le temps qu'il a fallu est CONSERVÉ dans « apparu_apres_s » : un
    service qui met 90 s à répondre n'est pas une panne, mais ce n'est pas rien —
    taire ce délai remplacerait une fausse alerte par un silence, et il finirait
    un jour par dépasser la patience de la sonde.

    « sonder » et « dormir » sont injectables pour que les tests exercent CETTE
    boucle sans attendre trois minutes ni ouvrir une socket.
    """
    sonder = sonder or _sonder
    dormir = dormir or time.sleep
    if budget is None:
        budget = int(os.environ.get("PRA_SANTE_PATIENCE_S", "180"))
    if pas is None:
        pas = int(os.environ.get("PRA_SANTE_PAS_S", "30"))
    pas = max(1, pas)
    attendu = 0
    while budget >= pas:
        retard_apps = [e for e in applications if e["verdict"] != "ok"]
        # « non sondable » n'est pas un retard : il n'y a rien à interroger, et
        # attendre trois minutes pour cela allongerait chaque nuit pour rien.
        retard_piles = [p for p in piles
                        if p["verdict"] not in ("ok", "non sondable")]
        if not retard_apps and not retard_piles:
            break
        dormir(pas)
        budget -= pas
        attendu += pas
        for e in retard_apps:
            cible = par_id.get(e["id"])
            if not cible:
                continue
            code = sonder(cible[3], hote=cible[4])
            # LE VERDICT EST RECALCULÉ, pas seulement le code. Reposer le code
            # sans le verdict laisserait la régression en place et l'alerte
            # partirait quand même : on aurait attendu pour rien, et le défaut
            # serait invisible — la famille « échoue exactement comme il réussit ».
            if _verdict_http(code) == "ok":
                e["code"], e["verdict"] = code, "ok"
                e["apparu_apres_s"] = attendu
        for p in retard_piles:
            code = sonder(f"http://127.0.0.1:{p['port']}/")
            if _verdict_http(code, racine_nue=True) == "ok":
                p["code"], p["verdict"] = code, "ok"
                p["apparu_apres_s"] = attendu
    # Le tri d'origine plaçait les échecs en tête : il faut le refaire, sinon la
    # page garderait les retardataires devant alors qu'ils vont bien.
    applications.sort(key=lambda x: (x["verdict"] == "ok", x["id"]))
    return attendu


def cmd_sante(_args) -> None:
    """L'ACCESSIBILITÉ RÉELLE, et non l'état des services.

    L'un ne dit rien de l'autre : un conteneur « running » peut rendre 502
    pendant des heures, et des conteneurs de migration « exited » sont des
    succès. Un tableau d'états de services rassure à tort.

    On sonde donc ce qu'un utilisateur ferait : l'URL de chaque application, et le
    port publié de chaque pile Docker. Les URL viennent de YunoHost — domaine et
    chemin de chaque application — et non d'une table à maintenir, qui se
    périmerait en silence à la première application ajoutée.
    """
    applications = []
    try:
        r = subprocess.run(
            ["yunohost", "app", "list", "--full", "--output-as", "json"],
            capture_output=True, timeout=90,
        )
        données = json.loads(r.stdout.decode("utf-8", "replace"))
    except Exception:
        données = {}

    # EN PARALLÈLE, sinon la page expire avant de répondre. Vingt-neuf adresses
    # avec six secondes de patience chacune font près de trois minutes en série —
    # bien au-delà du délai d'un mandataire HTTP. En parallèle, l'ensemble tient
    # dans le temps de la plus lente.
    aFaire = []
    for a in (données.get("apps") or []):
        ident = a.get("id") or a.get("name")
        if not ident:
            continue
        réglages = a.get("settings") or {}
        dom = réglages.get("domain") or a.get("domain")
        chemin = réglages.get("path") or a.get("path") or "/"
        if not dom:
            continue                      # application sans URL : rien à sonder
        if not chemin.endswith("/"):
            chemin += "/"
        # DEUX ADRESSES, et non une : celle qu'on MONTRE et celle qu'on SONDE.
        # Elles ne coïncident que par défaut. Afficher l'adresse de sonde
        # enverrait l'utilisateur sur un document JSON de découverte au lieu de
        # son application.
        url = f"https://{dom}{chemin}"
        sonde = CHEMINS_SONDE.get(ident, "")
        aFaire.append((ident, a.get("label") or ident, url, url + sonde, dom))

    with cf.ThreadPoolExecutor(max_workers=12) as pool:
        codes = list(pool.map(lambda t: _sonder(t[3], hote=t[4]), aFaire))
    for (ident, nom, url, url_sonde, _dom), code in zip(aFaire, codes):
        entree = {
            "id": ident, "nom": nom, "url": url, "code": code,
            "verdict": _verdict_http(code),
        }
        if url_sonde != url:
            entree["sonde"] = url_sonde   # pour que le verdict soit vérifiable
        applications.append(entree)
    applications.sort(key=lambda x: (x["verdict"] == "ok", x["id"]))

    # ── piles Docker : le port publié, pas l'état des conteneurs ─────────────
    piles = []
    racine = Path(os.environ.get("PRA_DOCKER_ROOT", "/opt/pra-docker"))
    if racine.is_dir():
        for d in sorted(racine.iterdir()):
            if not d.is_dir() or d.name == ".work":
                continue
            port = mandataire = None
            try:
                r = subprocess.run(
                    ["docker", "compose", "ps", "--format",
                     "{{.Service}} {{.Ports}}"],
                    cwd=str(d), capture_output=True, timeout=30,
                )
                # TOUTE PUBLICATION, PAS SEULEMENT « 127.0.0.1: ».
                #
                # Un filtre qui ne reconnaît que les liaisons explicitement
                # bouclées rate « 0.0.0.0:8077->80/tcp », qui inclut pourtant la
                # boucle locale : la pile est alors déclarée « non sondable,
                # réseau host » alors qu'elle publie bien un port et qu'elle est
                # en panne. Deux erreurs d'un coup : un
                # diagnostic faux, et une panne masquée.
                #
                # La flèche est ce qui distingue une publication d'un port
                # simplement exposé : « 3000/tcp » n'est joignable que depuis
                # le réseau du compose, « 0.0.0.0:8077->80/tcp » l'est d'ici.
                for ligne in r.stdout.decode("utf-8", "replace").splitlines():
                    for m in re.finditer(r"(?:([\d.]+|\[::\]):)?(\d+)->", ligne):
                        hote, p = m.group(1), m.group(2)
                        if hote in (None, "0.0.0.0", "127.0.0.1"):
                            port, mandataire = p, ligne.split()[0]
                            break
                    if port:
                        break
            except Exception:
                pass
            if not port:
                # Réseau host ou aucune publication locale : il n'y a rien à
                # sonder, et le dire vaut mieux que de laisser une ligne vide.
                # On ne dit pas « réseau host » : ce serait une DÉDUCTION, et
                # elle est souvent fausse. On dit ce qu'on observe.
                piles.append({"nom": d.name, "port": None, "mandataire": None,
                              "code": None, "verdict": "non sondable"})
                continue
            code = _sonder(f"http://127.0.0.1:{port}/")
            piles.append({"nom": d.name, "port": port, "mandataire": mandataire,
                           "code": code,
                           # racine_nue : on interroge « / » sur le port publié, or
                           # une pile peut vivre sous un sous-chemin. Un 404 y est
                           # un succès du mandataire, pas une panne.
                           "verdict": _verdict_http(code, racine_nue=True)})

    # ── SECONDE CHANCE POUR CE QUI NE RÉPOND PAS ENCORE ─────────────────────
    # Réservé à l'appel de la nuit : voir _seconde_chance().
    if getattr(_args, "patienter", False):
        _seconde_chance(applications, piles, {t[0]: t for t in aFaire})

    # ── COMPARER À LA MESURE PRÉCÉDENTE ─────────────────────────────────────
    #
    # Une RÉGRESSION parle infiniment mieux qu'un état absolu. « 24 applications
    # joignables » ne dit rien ; « hier 29, ce matin 24, voici lesquelles ont
    # cessé de répondre » désigne le problème. C'est le seul signal qu'aucun de
    # nos verdicts ne savait produire.
    #
    # On ne compare que dans un sens : ce qui répondait et ne répond plus. Une
    # application qui se met à répondre est une bonne nouvelle, pas une alerte —
    # et noyer les régressions dans les améliorations ferait cesser de lire.
    ancien = _json_si_possible(ETAT_DIR / "sante.json") or {}
    ok_avant = {a["id"] for a in ancien.get("applications", [])
                if a.get("verdict") == "ok"}
    ok_apres = {a["id"] for a in applications if a["verdict"] == "ok"}
    piles_avant = {p["nom"] for p in ancien.get("piles", [])
                   if p.get("verdict") == "ok"}
    piles_apres = {p["nom"] for p in piles if p["verdict"] == "ok"}
    regressions = sorted(ok_avant - ok_apres) + sorted(piles_avant - piles_apres)

    resultat = {
        "applications": applications,
        "piles": piles,
        "horodatage": time.strftime("%Y-%m-%d %H:%M:%S"),
        "precedent": ancien.get("horodatage"),
        "regressions": regressions,
        # Les compteurs servent au message d'alerte : « 29 → 24 » se lit d'un
        # coup d'œil, une liste de trente lignes non.
        "ok_avant": len(ok_avant) + len(piles_avant) if ancien else None,
        "ok_apres": len(ok_apres) + len(piles_apres),
    }
    # ÉCRIT SUR DISQUE, PAS RENVOYÉ POUR STOCKAGE EN SESSION.
    #
    # Stocker ce résultat dans la session revient à le mettre dans un COOKIE.
    # Quelques dizaines d'applications et de piles font déjà près de 4 ko bruts,
    # et une fois signée puis encodée la charge dépasse les 4096 octets qu'un
    # navigateur accepte : le cookie est jeté EN SILENCE et la page reste vide —
    # on appuie sur « sonder maintenant » et il ne vient aucun résultat.
    #
    # Le fichier a deux autres avantages : la mesure survit à un rafraîchissement,
    # et son horodatage reste vrai — on ne peut pas confondre « pas encore sondé »
    # avec « sondé et tout va bien ».
    try:
        ETAT_DIR.mkdir(parents=True, exist_ok=True)
        tmp = ETAT_DIR / "sante.json.tmp"
        tmp.write_text(json.dumps(resultat, ensure_ascii=False), encoding="utf-8")
        tmp.replace(ETAT_DIR / "sante.json")      # remplacement atomique
    except Exception as exc:
        echouer(f"résultat non enregistré : {exc}")
    sortir({"ok": True, "horodatage": resultat["horodatage"],
            "applications": len(applications), "piles": len(piles),
