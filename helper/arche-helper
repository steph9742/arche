def cmd_tracer(args) -> None:
    """Consigne une action et son auteur.

    Écrit par le HELPER, donc dans un fichier que le compte de service ne peut
    pas réécrire : une trace que l'application pourrait effacer ne vaudrait rien
    le jour où l'on cherche à savoir qui a lancé quoi.
    """
    # Ce qu'il faut réellement interdire, c'est la MISE EN FORME du journal :
    # sauts de ligne (une fausse entrée) et tabulations (le séparateur de
    # colonnes). Un filtre par liste blanche ASCII, comme dans la v1, supprimait
    # aussi les accents — « réglages enregistrés » s'y écrivait « rglages
    # enregistrs ». str.isprintable() écarte tout caractère de contrôle, tabulation
    # et saut de ligne compris, tout en gardant les lettres accentuées.
    def _propre(valeur: str, maxi: int, espaces: bool) -> str:
        gardés = [c for c in (valeur or "") if c.isprintable() and (espaces or not c.isspace())]
        texte = "".join(gardés)
        # Une troncature SILENCIEUSE dans un journal d'audit ferait passer une
        # trace incomplète pour complète : on la signale.
        return texte[: maxi - 12] + " …(tronqué)" if len(texte) > maxi else texte

    qui = _propre(args.qui, 64, espaces=False) or "?"
    quoi = _propre(args.quoi, 1024, espaces=True) or "?"
    AUDIT.parent.mkdir(parents=True, exist_ok=True)
    with open(AUDIT, "a", encoding="utf-8") as f:
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')}\t{qui}\t{quoi}\n")
    os.chmod(AUDIT, 0o640)
    sortir({"ok": True})


