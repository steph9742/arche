def _travail_en_cours(pidfile: Path, unite: str) -> bool:
    """Le travail tourne-t-il ? Deux façons de le lancer, deux façons de le voir.

    « os.kill(pid, 0) » est le contrôle historique, et il est FAUX depuis qu'on
    lance par systemd-run : la fonction rend alors 0 — l'unité vit sa vie, il n'y
    a pas de PID à rendre — et « kill(0, 0) » vise LE GROUPE DE PROCESSUS
    COURANT, donc réussit toujours. Le tableau de bord affichait « restauration
    en cours » indéfiniment, et les boutons restent désactivés.

    On interroge donc systemd quand c'est lui qui porte le travail, et on ne
    retombe sur le PID que pour le repli en processus détaché.
    """
    try:
        r = subprocess.run(["systemctl", "is-active", unite],
                           capture_output=True, timeout=10)
        if r.stdout.decode().strip() == "active":
            return True
    except Exception:
        pass
    try:
        pid = int(pidfile.read_text().strip())
    except Exception:
        return False
    if pid <= 0:
        return False                     # 0 = lancé par systemd, déjà vu ci-dessus
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _restauration_en_cours() -> bool:
    return _travail_en_cours(PIDFILE, "arche-restauration.service")


def cmd_restaurer(args) -> None:
    if _restauration_en_cours():
        echouer("une restauration est déjà en cours")
    binaire = SBIN / "pra_restore_replica.sh"
    if not binaire.exists():
        echouer(f"{binaire} absent")

    env = dict(os.environ)
    if args.valider:
        env["PRA_DRY_RUN"] = "1"
    else:
        env.pop("PRA_DRY_RUN", None)

    # Une validation qui éteindrait la machine n'a pas de sens : on valide
    # justement pour REGARDER le résultat. Le refus est explicite plutôt que
    # silencieux — sinon on croirait avoir programmé une extinction.
    if getattr(args, "halt", False):
        if args.valider:
            echouer("l'extinction n'a pas de sens en validation : "
                    "on valide pour examiner le résultat")
        env["PRA_HALT_APRES"] = "1"
    if getattr(args, "sans_controles", False):
        env["PRA_FORCE_ALL"] = "1"
    if getattr(args, "sans_transfert", False):
        env["PRA_SKIP_FETCH"] = "1"

    # ── ARCHIVE DÉSIGNÉE ────────────────────────────────────────────────────
    #
    # LE GESTE LE PLUS CRITIQUE DU DISPOSITIF. Le jour d'un rançongiciel,
    # l'archive la plus récente est justement celle dont on se méfie : il faut
    # remonter à une nuit antérieure. Jusqu'ici cela n'existait qu'en ligne de
    # commande, par PRA_ARCHIVE — donc au moment où l'on est le moins disponible
    # pour retrouver une commande dans une documentation.
    #
    # Le nom vient de l'interface, donc d'un compte non privilégié, et sert à
    # désigner un fichier lu en root. On le revalide ici intégralement, selon le
    # principe de ce helper : la webapp n'est jamais crue sur parole.
    #
    #   1. nommage EXACT AAAAMMJJ-HHMMSS(.tar) — aucun caractère de chemin ne
    #      peut passer ce filtre, donc ni « .. » ni « / » ;
    #   2. le fichier doit exister DANS le magasin attendu ;
    #   3. le chemin résolu doit toujours être dans ce magasin — ceinture et
    #      bretelles contre un lien symbolique déposé entre-temps.
    archive = (getattr(args, "archive", "") or "").strip()
    if archive:
        if not re.fullmatch(r"\d{8}-\d{6}(\.tar)?", archive):
            echouer("nom d'archive inattendu (AAAAMMJJ-HHMMSS attendu)")
        magasin = Path(os.environ.get("PRA_BACKUP_SRC", "/transferts/backups"))
        chemin = magasin / (archive if archive.endswith(".tar") else f"{archive}.tar")
        try:
            reel = chemin.resolve()
            if reel.parent != magasin.resolve() or not reel.is_file():
                raise FileNotFoundError
        except Exception:
            echouer(f"archive introuvable dans {magasin} : {archive}")
        env["PRA_ARCHIVE"] = str(reel)
        # Le jour de l'archive, transmis au volet Docker pour qu'il apparie son
        # instantané. Sans lui il prendrait le plus récent — et choisir une
        # archive antérieure pour fuir un chiffrement laisserait les piles Docker
        # ramener celui du jour.
        env["PRA_JOUR"] = reel.name[:8]
        # Et l'heure : elle départage l'instantané périodique d'un instantané
        # manuel du même jour, dès lors que les noms la portent.
        env["PRA_HEURE"] = reel.name[9:15]

    # L'INSTANTANÉ DOCKER, DÉSIGNÉ EXPLICITEMENT. Même validation que l'archive :
    # nommage exact, existence, appartenance au magasin après résolution.
    # Sert quand on veut dissocier les deux — piles d'avant-hier avec un YunoHost
    # d'hier, par exemple, si la contamination n'a pas touché les deux au même
    # moment.
    snap = (getattr(args, "docker_snapshot", "") or "").strip()
    if snap:
        # Deux nommages : « AAAAMMJJ-docker » (historique) et
        # « AAAAMMJJ-HHMMSS-docker » (l'heure distingue cron et manuel).
        if not re.fullmatch(r"\d{8}(-\d{6})?-docker(\.tar)?", snap):
            echouer("nom d'instantané inattendu (AAAAMMJJ[-HHMMSS]-docker attendu)")
        magasin = Path(os.environ.get("PRA_BACKUP_SRC", "/transferts/backups"))
        chemin = magasin / (snap if snap.endswith(".tar") else f"{snap}.tar")
        try:
            reel = chemin.resolve()
            if reel.parent != magasin.resolve() or not reel.is_file():
                raise FileNotFoundError
        except Exception:
            echouer(f"instantané Docker introuvable : {snap}")
        env["PRA_DOCKER_SNAPSHOT"] = reel.name
        # Le script pose lui-même SKIP_FETCH quand PRA_ARCHIVE est défini — aller
        # rechercher une archive désignée sur une production peut-être compromise
        # n'aurait aucun sens. On ne le redit pas ici pour ne pas laisser croire
        # que c'est notre décision.

    # Le volet Docker est enchaîné PAR DÉFAUT : « Restaurer maintenant » doit
    # rendre un réplica complet, pas un réplica où les applications YunoHost
    # sont à jour et où les piles Docker datent de la veille. On peut s'en
    # passer, mais il faut le demander.
    # En validation, il n'a pas lieu d'être : rien n'est modifié.
    if not args.valider and not getattr(args, "sans_docker", False):
        env["PRA_AVEC_DOCKER"] = "1"

    # Détaché : une restauration réelle dure une dizaine de minutes. La garder
    # synchrone ferait expirer la requête HTTP et laisserait l'utilisateur sans
    # savoir si l'opération continue. Le suivi se fait par le journal.
    # Dans son propre cgroup : une restauration dure une dizaine de minutes et un
    # déploiement pendant ce temps la tuerait. Voir _lancer_hors_cgroup.
    journal = JOURNAUX["restauration"]
    pid = _lancer_hors_cgroup(
        "restauration", [str(binaire)], journal,
        env={c: v for c, v in env.items() if c.startswith("PRA_")},
        ajouter=True,
    )
    PIDFILE.write_text(str(pid))
    sortir(
        {
            "ok": True,
            # « proc.pid » ici référençait une variable qui n'existe QUE dans
            # la branche de repli de _lancer_hors_cgroup. Avec systemd-run —
            # le chemin normal — la fonction rend un entier, et la réponse
            # levait NameError. Le travail, lui, était DÉJÀ LANCÉ : l'interface
            # affiche « Échec » sur une restauration qui tourne, ce qui est
            # pire qu'un échec franc.
            "pid": pid,
            "mode": "validation" if args.valider else "réelle",
            "halt": bool(getattr(args, "halt", False)),
            "sans_controles": bool(getattr(args, "sans_controles", False)),
            "sans_transfert": bool(getattr(args, "sans_transfert", False)),
            "avec_docker": bool(env.get("PRA_AVEC_DOCKER")),
        }
    )


# ── sauvegarde à la demande (rôle production) ───────────────────────────────


def cmd_sauvegarder(args) -> None:
    """Lance la sauvegarde YunoHost EN TÂCHE DE FOND.

    Comme la restauration : l'opération dure longtemps (12 Go), la garder
    synchrone ferait expirer la requête HTTP et laisserait l'utilisateur sans
    savoir si elle continue.
    """
    binaire = SBIN / "yunohost_backup_daily.sh"
    if not binaire.exists():
        # Historiquement installé dans /usr/local/bin sur la production.
        autre = Path("/usr/local/bin/yunohost_backup_daily.sh")
        if autre.exists():
            binaire = autre
        else:
            echouer(f"{binaire} absent")
    if _sauvegarde_en_cours():
        echouer("une sauvegarde est déjà en cours")

    # L'instantané Docker est enchaîné PAR DÉFAUT. Sans lui, une sauvegarde
    # lancée à la main ne contient que le volet YunoHost, et l'arche répliquerait
    # des piles Docker datant de la veille — sans que rien ne le signale.
    env = dict(os.environ)
    if getattr(args, "sans_docker", False):
        env.pop("PRA_AVEC_DOCKER", None)
    else:
        env["PRA_AVEC_DOCKER"] = "1"

    # LE journal de la sauvegarde, pas un fichier à part. On écrivait dans
    # /var/log/pra_backup.log, que rien d'autre ne lisait ni n'écrivait : la
    # sortie brute de « yunohost backup » y atterrissait seule, tandis que
    # l'onglet de l'interface — qui pointait aussi vers ce fichier — restait
    # vide. En redirigeant vers le journal du script, tout est au même endroit :
    # ses lignes horodatées, et la sortie brute de YunoHost entre elles.
    journal = JOURNAUX["sauvegarde"]
    # Dans son propre cgroup, comme la restauration : une sauvegarde de 12 Go dure
    # une demi-heure, et c'est exactement le genre d'opération qu'un déploiement
    # tuait sans le dire.
    pid = _lancer_hors_cgroup(
        "sauvegarde", [str(binaire)], journal,
        env={c: v for c, v in env.items() if c.startswith("PRA_")},
        ajouter=True,
    )
    PIDFILE_BACKUP.write_text(str(pid))
    sortir({"ok": True, "pid": pid,
            "avec_docker": bool(env.get("PRA_AVEC_DOCKER"))})


def _sauvegarde_en_cours() -> bool:
    return _travail_en_cours(PIDFILE_BACKUP, "arche-sauvegarde.service")


# ── alerte d'essai ──────────────────────────────────────────────────────────


def cmd_tester_alerte(_args) -> None:
    binaire = SBIN / "pra_notify.sh"
    if not binaire.exists():
        echouer(f"{binaire} absent")
    r = subprocess.run(
        [str(binaire), "info", "Essai depuis la webapp Arche",
         "Si vous lisez ceci, la chaîne d'alerte fonctionne."],
        capture_output=True, timeout=60,
    )
    # pra_notify.sh sort toujours en 0 par conception : le verdict réel est dans
    # son journal, qu'on relit pour dire la vérité à l'utilisateur.
    derniere = ""
    try:
        lignes = JOURNAUX["alertes"].read_text(errors="replace").splitlines()
        derniere = lignes[-1] if lignes else ""
    except OSError:
        pass
    sortir({"ok": "transmise" in derniere, "detail": derniere or
            (r.stdout + r.stderr).decode("utf-8", "replace").strip()})


# ── point d'entrée ──────────────────────────────────────────────────────────


def main() -> None:
    p = argparse.ArgumentParser(prog="arche-helper", add_help=True)
    sp = p.add_subparsers(dest="commande", required=True)

    sp.add_parser("etat").set_defaults(fn=cmd_etat)
    sp.add_parser("conf-lire").set_defaults(fn=cmd_conf_lire)
    sp.add_parser("conf-ecrire").set_defaults(fn=cmd_conf_ecrire)

    pj = sp.add_parser("journal")
    pj.add_argument("quoi", choices=sorted(JOURNAUX))
    pj.add_argument("lignes", type=int, nargs="?", default=200)
    pj.set_defaults(fn=cmd_journal)

    pc = sp.add_parser("canaris")
    pc.add_argument("action", choices=sorted(CANARIS_ACTIONS))
    pc.set_defaults(fn=cmd_canaris)

    pr = sp.add_parser("restaurer")
    g = pr.add_mutually_exclusive_group(required=True)
    g.add_argument("--valider", action="store_true")
    g.add_argument("--reel", action="store_true")
    # Options d'une restauration lancée à la main. Ce sont des DRAPEAUX, pas des
    # valeurs : rien de ce que l'appelant envoie n'entre dans une commande.
    pr.add_argument("--halt", action="store_true")
    pr.add_argument("--sans-controles", action="store_true")
    pr.add_argument("--sans-transfert", action="store_true")
    pr.add_argument("--sans-docker", action="store_true")
    # La SEULE valeur acceptée de l'appelant sur cette commande, et elle est
    # revalidée intégralement dans cmd_restaurer : nommage exact, existence, et
    # appartenance au magasin après résolution des liens.
    pr.add_argument("--archive", default="")
    pr.add_argument("--docker-snapshot", default="")
    pr.set_defaults(fn=cmd_restaurer)

    p_sante = sp.add_parser("sante")
    # Réservé à l'appel de la nuit : la page Santé de l'interface doit répondre
    # tout de suite, attendre trois minutes la ferait expirer.
    p_sante.add_argument("--patienter", action="store_true",
                         help="redemander à ce qui ne répond pas encore")
    p_sante.set_defaults(fn=cmd_sante)
    sp.add_parser("sante-lire").set_defaults(fn=cmd_sante_lire)
    sp.add_parser("apps").set_defaults(fn=cmd_apps)
    sp.add_parser("cibles").set_defaults(fn=cmd_cibles)
    sp.add_parser("depot-etat").set_defaults(fn=cmd_depot_etat)
    sp.add_parser("depot-verifier").set_defaults(fn=cmd_depot_verifier)
    sp.add_parser("depot-majour").set_defaults(fn=cmd_depot_majour)
    sp.add_parser("depot-nettoyer").set_defaults(fn=cmd_depot_nettoyer)

    pt = sp.add_parser("tracer")
    pt.add_argument("qui")
    pt.add_argument("quoi")
    pt.set_defaults(fn=cmd_tracer)

    ps = sp.add_parser("sauvegarder")
    ps.add_argument("--sans-docker", action="store_true")
    ps.set_defaults(fn=cmd_sauvegarder)
    sp.add_parser("tester-alerte").set_defaults(fn=cmd_tester_alerte)

    args = p.parse_args()
    if os.geteuid() != 0:
        echouer("ce helper doit être exécuté en root (via sudo)")
    args.fn(args)


if __name__ == "__main__":
    main()
