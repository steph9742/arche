    # écarter deux clics simultanés, ce que pgrep ne peut pas faire.
    _depot_prendre_verrou("une mise à jour")
    pid = _lancer_hors_cgroup("depot", [str(DEPOT_SCRIPT)], DEPOT_JOURNAL)
    _depot_rendre_verrou()
    sortir({"ok": True, "pid": pid})


