def _json_si_possible(chemin: Path) -> dict | None:
    try:
        return json.loads(chemin.read_text(encoding="utf-8"))
    except Exception:
        return None


def _service(nom: str) -> str:
    try:
        r = subprocess.run(
            ["systemctl", "is-active", nom], capture_output=True, timeout=10
        )
        return r.stdout.decode().strip() or "inconnu"
    except Exception:
        return "inconnu"


def _service_enable(nom: str) -> str:
    """« is-enabled » et non « is-active » : un minuteur ACTIF mais DÉSACTIVÉ ne
    survivra pas au redémarrage suivant, et rien ne le signalait.

    Les deux états sont indépendants et se combinent en quatre cas. Seul
    « enabled + active » est sain ; « active + disabled » est le piège, parce
    qu'il paraît sain aujourd'hui et ne l'est plus après un reboot.
    """
    try:
        r = subprocess.run(
            ["systemctl", "is-enabled", nom], capture_output=True, timeout=10
        )
        return r.stdout.decode().strip() or "inconnu"
    except Exception:
        return "inconnu"


def cmd_etat(_args) -> None:
    # DEUX LISTES SÉPARÉES, et non un seul tas de « .tar ».
    #
    # Le magasin contient deux familles : les archives YunoHost
    # « AAAAMMJJ-HHMMSS.tar » et les instantanés Docker « AAAAMMJJ-docker.tar ».
    # Les mêler faisait proposer un instantané Docker dans le sélecteur d'archive
    # YunoHost — un choix que la validation rejette toujours, donc une option qui
    # ne peut mener qu'à un échec.
    archives, instantanes = [], []
    src = Path("/transferts/backups")
    if src.is_dir():
        for f in sorted(src.glob("*.tar"), key=lambda p: p.stat().st_mtime, reverse=True):
            try:
                st = f.stat()
                entree = {
                    "nom": f.name,
                    "taille": st.st_size,
                    "date": time.strftime("%Y-%m-%d %H:%M", time.localtime(st.st_mtime)),
                    "jour": f.name[:8] if f.name[:8].isdigit() else None,
                }
            except OSError:
                continue
            if f.name.endswith("-docker.tar"):
                instantanes.append(entree)
            elif re.fullmatch(r"\d{8}-\d{6}\.tar", f.name):
                archives.append(entree)
            # Le reste — « bookstack-pre-upgrade1.tar » et consorts — n'est ni
            # l'un ni l'autre : ce sont les sauvegardes que YunoHost prend avant
            # une mise à niveau. Les proposer n'aurait pas de sens.

    services_morts = []
    try:
        r = subprocess.run(
            ["systemctl", "list-units", "--state=failed", "--no-pager",
             "--plain", "--no-legend"],
            capture_output=True, timeout=15,
        )
        for ligne in r.stdout.decode("utf-8", "replace").splitlines():
            unite = ligne.split()[0] if ligne.split() else ""
            # mariadb.socket échoue par activation par socket alors que mariadb
            # tourne : sans conséquence, on ne l'affiche pas comme un problème.
            if unite and unite != "mariadb.socket":
                services_morts.append(unite)
    except Exception:
        pass

    sortir(
        {
            "yunohost": _json_si_possible(ETAT_DIR / "status.json"),
            "docker": _json_si_possible(ETAT_DIR / "docker-status.json"),
            # Côté production : l'état des reçus de l'arche TEL QUE DÉCIDÉ par
            # pra_recu_verifier.sh. La carte affiche cette décision-là, jamais
            # une seconde lecture des reçus qui pourrait diverger de l'alerte et
            # de l'API publique.
            "recu": _json_si_possible(ETAT_DIR / "recu-etat.json"),
            "archives": archives[:12],
            "instantanes": instantanes[:12],
            "services_morts": services_morts,
            "restauration_en_cours": _restauration_en_cours(),
            "sauvegarde_en_cours": _sauvegarde_en_cours(),
            "canaris_configures": Path(
                os.environ.get("ARCHE_CANARY_MANIFEST", "/etc/pra/canaries.list")
            ).exists(),
            "timer": _service("pra-nightly.timer"),
            "timer_enable": _service_enable("pra-nightly.timer"),
            "prochain_reveil": _prochain_reveil(),
        }
    )


