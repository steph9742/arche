def cmd_conf_ecrire(_args) -> None:
    try:
        charge = json.load(sys.stdin)
    except json.JSONDecodeError:
        echouer("charge utile illisible (JSON attendu)")
    valeurs = charge.get("valeurs")
    if not isinstance(valeurs, dict):
        echouer("charge utile invalide : « valeurs » doit être un objet")

    inconnues = set(valeurs) - set(PAR_CLE)
    if inconnues:
        echouer(f"réglage(s) inconnu(s) : {', '.join(sorted(inconnues))}")

    anciennes = conf_lire_fichier(CONF)

    # FUSION avec l'existant, et non remplacement. L'interface n'envoie que les
    # réglages de SON rôle : sans fusion, configurer le rôle « production »
    # effacerait ceux de l'arche, et réciproquement. Le fichier reste unique et
    # partagé par les deux volets.
    fusion = dict(anciennes)
    fusion.update(valeurs)
    valeurs = fusion

    # Un secret laissé masqué signifie « ne pas changer » : on relit l'ancienne
    # valeur plutôt que d'écrire les points de masquage dans le fichier.
    for cle in SECRETS:
        if valeurs.get(cle, "").startswith("●"):
            valeurs[cle] = anciennes.get(cle, "")

    # REVALIDATION COMPLÈTE. La webapp a déjà validé, mais elle tourne sous un
    # compte non privilégié : si elle est compromise, ce contrôle-ci est le
    # dernier avant un fichier lu par des scripts root.
    try:
        propre = valider(valeurs)
        # Les lignes hors schéma sont relues du fichier EXISTANT et reconduites :
        # sans cela, chaque enregistrement effaçait ce que le schéma ignore —
        # jetons et réglages posés à la main en font les frais le jour où
        # quelqu'un enregistre le formulaire.
        contenu = rendre(propre, lire_hors_schema(CONF))
    except ValeurInvalide as exc:
        echouer(str(exc))

    CONF.parent.mkdir(parents=True, exist_ok=True)
    # Écriture atomique : un fichier tronqué serait sourcé tel quel par le
    # prochain script et produirait une configuration partielle silencieuse.
    tmp = CONF.with_suffix(".tmp")
    tmp.write_text(contenu, encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.chown(tmp, 0, 0)
    os.replace(tmp, CONF)
    sortir({"ok": True, "reglages": len(propre)})


